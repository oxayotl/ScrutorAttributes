<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <!-- Package Metadata -->
    <Description>Convention-based dependency injection for .NET using Scrutor. 
Automatically register services by adding Attribute to your classes - no manual registration needed. 
Works with ASP.NET Core, Blazor, Worker Services, and any .NET app using DI.</Description>
    <PackageTags>dependency-injection;di;scrutor;convention-based;attribute;ioc;aspnetcore;dotnet;blazor;worker-service;automatic-registration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>See https://github.com/oxayotl/ScrutorAttributes/releases for detailed release notes</PackageReleaseNotes>

    <!-- Version & Authors -->
    <Version>0.1.0</Version>
    <Authors>Jean-Alexandre Anglès d'Auriac</Authors>
    <Copyright>Copyright (c) 2025 Jean-Alexandre Anglès d'Auriac</Copyright>

    <!-- Repository Info -->
    <RepositoryUrl>https://github.com/oxayotl/ScrutorAttributes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/oxayotl/ScrutorAttributes</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Assembly Info -->
    <AssemblyName>ScrutorAttributes</AssemblyName>
    <RootNamespace>ScrutorAttributes</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- SourceLink Support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Build Quality -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Nullable>enable</Nullable>
    <PackageId>oxayotl.$(AssemblyName)</PackageId>
    <Title>Scrutor Attributes</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
